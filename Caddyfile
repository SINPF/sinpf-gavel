{
	# Use Caddy's internal CA (self-signed) for all TLS.
	# The CA is stored in the caddy_data volume so certs persist across restarts.
	local_certs
}

# ── HTTPS ────────────────────────────────────────────────────────────────────
gavel.sinpf.org.sb {
	tls internal

	# MinIO storage proxy — /storage/* → minio:9000/*
	# Host is forced to minio:9000 so pre-signed URL signatures remain valid.
	handle_path /storage/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
			flush_interval -1
		}
	}

	# Next.js app
	handle {
		reverse_proxy web:3000
	}

	request_body {
		max_size 50MB
	}
}

# Caddy auto-adds an HTTP→HTTPS redirect on :80 for the hostname above,
# so no explicit :80 block is needed.
