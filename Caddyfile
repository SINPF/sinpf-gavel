{
	auto_https off
}

:80 {
	# MinIO storage proxy — /storage/* → minio:9000/*
	# Host is forced to minio:9000 so pre-signed URL signatures remain valid.
	handle_path /storage/* {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
			flush_interval -1
		}
	}

	# Next.js app
	handle {
		reverse_proxy web:3000
	}

	request_body {
		max_size 50MB
	}
}
